# Connects to audit_logs_db using the audit_portal role (CREATE granted on
# public schema so this app can create + own its 2 auth tables — see the
# plan's Global Constraints for why this isn't a security regression).
PORTAL_DB_URL=postgresql://audit_portal:CHANGE_ME@localhost:5432/audit_logs_db

# JWT signing secret for the httpOnly session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME

PORT=4000

# Decryption key for reading audit-log-shipper's S3 archives (Task 10).
# Must match audit-log-shipper's ARCHIVE_ENCRYPTION_KEY exactly.
ARCHIVE_ENCRYPTION_KEY=CHANGE_ME
AWS_REGION=ap-south-1
AUDIT_ARCHIVE_S3_BUCKET=cred2tech-audit-log-archive

# Optional: used only by integration tests, points at a scratch schema in
# the same Postgres instance.
TEST_AUDIT_DB_URL=
